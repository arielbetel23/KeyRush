<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="KeyRush_Pages_MasterPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KeyRush</title>
    <link rel="icon" href="../Images/Logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="../Styles/Navbar.css" />
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>

<nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
        <a class="navbar-brand" href="Homepage.aspx">
            <img src="../Images/Logo.png" width="32" height="32" alt="Logo" />
            KeyRush
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="Homepage.aspx">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="CPS.aspx">CPS Test</a></li>
                <li class="nav-item"><a class="nav-link" href="Typing.aspx">Typing Test</a></li>
                <li class="nav-item"><a class="nav-link" href="EditUser.aspx">Edit Profile</a></li>
                <% if ((bool)Session["admin"] == true)
                       Response.Write("<li class=\"nav-item\"><a class=\"nav-link\" href=\"Admin.aspx\">Admin</a></li>");
                %>
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link btn-logout" href="Logout.aspx">Log Out</a></li>
            </ul>
        </div>
    </div>
</nav>

    <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
    </asp:ContentPlaceHolder>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

